# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (PostgreSQL) ---
# e.g. a Neon, Supabase, or local Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/distill

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Stripe ---
# Use the real keys from your Stripe dashboard. Placeholders below intentionally
# do not resemble real key formats so they are never flagged as leaked secrets.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Stripe Price IDs for each paid tier (create them in the Stripe dashboard).
STRIPE_PRICE_PRO=your-pro-price-id
STRIPE_PRICE_TEAM=your-team-price-id

# Public base URL (used for Stripe redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
